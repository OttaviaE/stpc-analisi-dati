<!-- question: 215598  -->
  <question type="multichoice">
    <name>
      <text>5</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p></p><p>
Sia Dati un dataframe composto da 3
colonne denominate “x”,”y” e “z” e 36 righe
corrispondenti a 36 soggetti. Quale sintassi permette di aggiungere
al dataframe una quarta variabile, denominata “Media”, derivante
dalla media dei valori attribuiti da ogni soggetto alle tre variabili
esistenti (“x”,”y”,”z”).</p><br><p></p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>123</answernumbering>
    <showstandardinstruction>1</showstandardinstruction>
    <correctfeedback format="html">
      <text>Risposta corretta.</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Risposta parzialmente esatta.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Risposta errata.</text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="100" format="html">
      <text><![CDATA[<p></p><pre>Dati$Media &lt;-apply(Dati[,1:3],1,mean)</pre><p></p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="-25" format="html">
      <text><![CDATA[<p></p><pre>Dati$Media &lt;-summary(Dati)[mean]</pre><p></p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="-25" format="html">
      <text><![CDATA[<p></p><pre>Dati$Media &lt;- mean(c(x,y,z))</pre><p></p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="-25" format="html">
      <text><![CDATA[<p></p><pre>Dati$Media &lt;- Dati$mean</pre><p></p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="-25" format="html">
      <text><![CDATA[<p></p><pre>mean(dati$x,dati$y,dati$z)</pre><p></p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>

