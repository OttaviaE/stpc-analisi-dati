<!-- question: 215594  -->
  <question type="multichoice">
    <name>
      <text>1</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>
</p>
<h4><pre></pre></h4><h4><pre></pre></h4><h5>Considerando un dataframe di nome D, contenente la variabile “genere” a due livelli “M” e “F”; la variabile “condizione” a due livelli “sperimentale” e “controllo” e la variabile quantitativa “tempo”. Indicare la sintassi che permette di selezionare quei valori della variabile tempo che siano associati ai maschi (“M”) nella condizione “sperimentale” o alle femmine (“F”) nella condizione di “controllo”.</h5><pre><h5></h5></pre><br>
<p></p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>123</answernumbering>
    <showstandardinstruction>1</showstandardinstruction>
    <correctfeedback format="html">
      <text>Risposta corretta.</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Risposta parzialmente esatta.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Risposta errata.</text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="-25" format="html">
      <text><![CDATA[<p></p><pre>D$tempo[(D$genere=="m"&amp;D$condizione=="sperimentale")|(D$genere=="f"&amp;D$condizione=="controllo")]</pre><br><p></p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="-25" format="html">
      <text><![CDATA[<pre>D$tempo[(D$genere=="M"&amp;D$condizione=="Sperimentale")|(D$genere=="F"&amp;D$condizione=="Controllo")]</pre>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<pre>D$tempo[(D$genere=="M"&amp;D$condizione=="sperimentale")|(D$genere=="F"&amp;D$condizione=="controllo")]</pre>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="-25" format="html">
      <text><![CDATA[<pre>D[(D$genere=="M"&amp;D$condizione=="sperimentale")|(D$genere=="F"&amp;D$condizione=="controllo")]</pre>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="-25" format="html">
      <text><![CDATA[<pre>D$tempo[(D$genere="M"&amp;D$condizione="sperimentale")|(D$genere="F"&amp;D$condizione="controllo")]</pre>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>

