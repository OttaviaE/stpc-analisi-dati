    <correctfeedback format="html">
      <text>Risposta corretta.</text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text>Risposta parzialmente esatta.</text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text>Risposta errata.</text>
    </incorrectfeedback>
    <shownumcorrect/>
    <answer fraction="-25" format="html">
      <text><![CDATA[<p><p>
nel dataframe dati non è presente
la variabile VAR1</p></p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[<p><p>
il simbolo di uguaglianza dovrebbe
seguire il simbolo di minore</p></p>]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="-25" format="html">
      <text><![CDATA[<p><p>
non dovrebbe essere presente il
simbolo di minore</p></p>]]></text>
      <feedback format="html">
        <text></text>
